# Database (Postgres). A free Neon project (https://neon.tech) works well for local dev.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# better-auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Third-party integrations ---
# Each *_MODE defaults to "stub" when unset, so the app runs with zero keys.
# Set to "live" per-service once real test-mode credentials are available.

STRIPE_MODE=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PRICE_ID=

CHECKR_MODE=stub
CHECKR_API_KEY=

TWILIO_MODE=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

POSTMARK_MODE=stub
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

S3_MODE=stub
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
